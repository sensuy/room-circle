generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Owner {
  id String @id @default(uuid())
  fullName String
  email String @unique
  phone String @unique
  passwordHash String
  referralCode String @unique
  referredById String?
  referredBy Owner? @relation("OwnerReferrals", fields: [referredById], references: [id], onDelete: Restrict)
  referrals Owner[] @relation("OwnerReferrals")
  phoneVerifiedAt DateTime?
  createdAt DateTime @default(now())

  @@index([referredById])
}
